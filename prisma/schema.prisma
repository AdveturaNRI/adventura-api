generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                     @id @default(cuid())
  email                       String                     @unique
  nickname                    String                     @unique
  passwordHash                String
  isGuest                     Boolean                    @default(false)
  emailVerifiedAt             DateTime?
  availability                String?
  age                         Int?
  location                    String?
  cityId                      String?
  timezone                    String                     @default("Europe/Moscow")
  playsOnline                 Boolean                    @default(false)
  isPublic                    Boolean                    @default(true)
  systems                     String[]                   @default([])
  readyToLearnNew             Boolean                    @default(false)
  openToAnySystem             Boolean                    @default(false)
  prefersFreeOnly             Boolean                    @default(false)
  about                       String?
  description                 String?
  roles                       String[]                   @default([])
  questionnaireStep           Int                        @default(0)
  notificationSoundsEnabled   Boolean                    @default(true)
  notificationSoundPresetId   String?
  useCustomNotificationSound  Boolean                    @default(false)
  lastSeenAt                  DateTime?
  equippedAvatarFrameId       String?
  equippedQuestionnaireAuraId String?
  visibleBadgeTypes           Json?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  refreshTokens               RefreshToken[]
  emailTokens                 EmailToken[]
  statuses                    UserStatus[]
  experiences                 UserExperience[]
  city                        City?                      @relation(fields: [cityId], references: [id], onDelete: SetNull)
  notificationSoundPreset     NotificationSoundPreset?   @relation("UserNotificationSoundPreset", fields: [notificationSoundPresetId], references: [id], onDelete: SetNull)
  userCities                  UserCity[]
  gameSystems                 UserGameSystem[]
  wandererReactionsGiven      WandererReaction[]         @relation("WandererReactionsGiven")
  wandererReactionsReceived   WandererReaction[]         @relation("WandererReactionsReceived")
  conversationsAsLow          Conversation[]             @relation("ConversationUserLow")
  conversationsAsHigh         Conversation[]             @relation("ConversationUserHigh")
  conversationReads           ConversationRead[]
  conversationParticipants    ConversationParticipant[]
  messagesSent                Message[]
  notificationsReceived       Notification[]             @relation("NotificationsReceived")
  notificationsActed          Notification[]             @relation("NotificationsActed")
  blocksGiven                 UserBlock[]                @relation("BlocksGiven")
  blocksReceived              UserBlock[]                @relation("BlocksReceived")
  gamesOwned                  Game[]
  clubsOwned                  Club[]
  clubMemberships             ClubMember[]
  gameApplications            GameApplication[]
  gamePlayers                 GamePlayer[]
  pushSubscriptions           PushSubscription[]
  rewards                     UserReward[]
  cosmeticUnlocks             UserCosmeticUnlock[]
  analyticsEvents             AnalyticsEvent[]
  authorProfile               AuthorProfile?
  authorPostLikes             AuthorPostLike[]
  marketingAttributionTouches MarketingAttributionTouch[]
  marketingConversions        MarketingConversion[]
  oauthAccounts               OAuthAccount[]

  @@index([notificationSoundPresetId])
}

enum OAuthProvider {
  VK
  YANDEX
}

model OAuthAccount {
  id             String        @id @default(cuid())
  provider       OAuthProvider
  providerUserId String
  email          String?
  linkedAt       DateTime      @default(now())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("oauth_accounts")
}

enum RewardBadgeType {
  alpha_tester
  bug_hunter
  founding_dm
  early_arrival
  tavern_keeper
}

model UserReward {
  id                  String          @id @default(cuid())
  userId              String
  badgeType           RewardBadgeType
  customDiceSkinId    String?
  bonusCharacterSlots Int             @default(0)
  grantedAt           DateTime        @default(now())
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeType])
  @@index([userId])
  @@map("user_rewards")
}

/// Косметика, разблокированная отдельно от наград: покупка, админка, позже подписка.
/// itemId = id рамки или "*" — все рамки этого kind.
model UserCosmeticUnlock {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  itemId    String
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, itemId])
  @@index([userId])
  @@map("user_cosmetic_unlocks")
}

model DailyUsageCounter {
  userId String
  kind   String
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([userId, kind, day])
  @@map("daily_usage_counters")
}

model NotificationSoundPreset {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  description String?
  /// Client-relative fallback, e.g. /sounds/notify-magic.mp3
  staticPath  String?
  sortOrder   Int      @default(0)
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]   @relation("UserNotificationSoundPreset")

  @@index([sortOrder])
  @@map("notification_sound_presets")
}

model Status {
  id        String       @id @default(cuid())
  name      String       @unique
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  users     UserStatus[]

  @@map("statuses")
}

model UserStatus {
  userId    String
  statusId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@id([userId, statusId])
  @@map("user_statuses")
}

model ExperienceType {
  id        String           @id @default(cuid())
  name      String           @unique
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  users     UserExperience[]
  games     Game[]

  @@map("experience_types")
}

model GameSystem {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isOfficial  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("game_systems")
}

model UserGameSystem {
  id             String   @id @default(cuid())
  userId         String
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  games          Game[]

  @@unique([userId, normalizedName])
  @@index([userId])
  @@map("user_game_systems")
}

enum GameKind {
  ONESHOT
  CAMPAIGN
}

enum GameStatus {
  RECRUITING
  CLOSED
  FINISHED
}

enum GameApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Game {
  id               String            @id @default(cuid())
  ownerId          String
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  userGameSystemId String
  userGameSystem   UserGameSystem    @relation(fields: [userGameSystemId], references: [id], onDelete: Restrict)
  title            String
  description      String?
  maxPlayers       Int
  durationHours    Int?
  kind             GameKind          @default(ONESHOT)
  status           GameStatus        @default(RECRUITING)
  isOnline         Boolean           @default(false)
  cityId           String?
  city             City?             @relation(fields: [cityId], references: [id], onDelete: SetNull)
  clubId           String?
  club             Club?             @relation(fields: [clubId], references: [id], onDelete: SetNull)
  scheduledAt      DateTime?
  timezone         String            @default("Europe/Moscow")
  priceRub         Int?
  experienceTypeId String?
  experienceType   ExperienceType?   @relation(fields: [experienceTypeId], references: [id], onDelete: SetNull)
  beginnersWelcome Boolean           @default(false)
  minAge           Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  applications     GameApplication[]
  players          GamePlayer[]
  conversation     Conversation?

  @@index([ownerId])
  @@index([userGameSystemId])
  @@index([cityId])
  @@index([clubId])
  @@index([scheduledAt])
  @@index([status])
  @@map("games")
}

model GameApplication {
  id        String                @id @default(cuid())
  gameId    String
  game      Game                  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    GameApplicationStatus @default(PENDING)
  message   String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([gameId, userId])
  @@index([gameId, status])
  @@index([userId])
  @@map("game_applications")
}

model GamePlayer {
  id       String   @id @default(cuid())
  gameId   String
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
  @@map("game_players")
}

model UserExperience {
  userId           String
  experienceTypeId String
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceType   ExperienceType @relation(fields: [experienceTypeId], references: [id], onDelete: Cascade)

  @@id([userId, experienceTypeId])
  @@map("user_experiences")
}

model Country {
  id        String   @id
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  cities    City[]

  @@map("countries")
}

model City {
  id         String     @id
  countryId  String
  name       String
  region     String?
  population Int        @default(0)
  geonameId  Int?       @unique
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  country    Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  users      User[]
  userCities UserCity[]
  games      Game[]
  clubs      Club[]

  @@unique([countryId, name, region])
  @@index([name])
  @@index([countryId, population])
  @@map("cities")
}

model UserCity {
  userId    String
  cityId    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([userId, cityId])
  @@index([cityId])
  @@index([userId, sortOrder])
  @@map("user_cities")
}

model Club {
  id          String       @id @default(cuid())
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  address     String
  lat         Float
  lng         Float
  cityId      String?
  city        City?        @relation(fields: [cityId], references: [id], onDelete: SetNull)
  tags        String[]     @default([])
  links       Json?
  /// Physical tables available at the venue.
  tablesCount Int          @default(1)
  /// JSON: [{ day: 1-7, closed, open: "HH:mm"|null, close: "HH:mm"|null }]
  schedule    Json
  isPublished Boolean      @default(true)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     ClubMember[]
  games       Game[]

  @@index([ownerId])
  @@index([cityId])
  @@index([lat, lng])
  @@index([deletedAt])
  @@map("clubs")
}

enum ClubMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model ClubMember {
  clubId    String
  userId    String
  role      ClubMemberRole @default(MEMBER)
  createdAt DateTime       @default(now())
  club      Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
  @@index([userId, role])
  @@map("club_members")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
  @@map("email_tokens")
}

model Media {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  collection  String
  variant     String
  mimeType    String
  path        String
  width       Int?
  height      Int?
  size        Int
  durationSec Int?
  waveform    Json?
  createdAt   DateTime @default(now())

  @@unique([entityType, entityId, collection, variant])
  @@index([entityType, entityId, collection])
}

enum WandererReactionType {
  FAVORITE
  SKIPPED
}

model WandererReaction {
  id           String               @id @default(cuid())
  viewerId     String
  targetUserId String
  type         WandererReactionType
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  viewer       User                 @relation("WandererReactionsGiven", fields: [viewerId], references: [id], onDelete: Cascade)
  target       User                 @relation("WandererReactionsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([viewerId, targetUserId])
  @@index([viewerId, type])
  @@index([targetUserId])
  @@map("wanderer_reactions")
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

model Conversation {
  id                 String                    @id @default(cuid())
  type               ConversationType          @default(DIRECT)
  title              String?
  gameId             String?                   @unique
  userLowId          String?
  userHighId         String?
  lastMessageAt      DateTime?
  /// Shared wallpaper: default | preset | custom. null = each user uses own settings.
  backgroundKind     String?
  backgroundPresetId String?
  backgroundUrl      String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  game               Game?                     @relation(fields: [gameId], references: [id], onDelete: SetNull)
  userLow            User?                     @relation("ConversationUserLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh           User?                     @relation("ConversationUserHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  messages           Message[]
  reads              ConversationRead[]
  participants       ConversationParticipant[]

  @@unique([userLowId, userHighId])
  @@index([lastMessageAt])
  @@index([type])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  userId         String
  role           ConversationParticipantRole @default(MEMBER)
  joinedAt       DateTime                    @default(now())
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model ConversationRead {
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  hiddenAt       DateTime?
  /// Когда чат закреплён у пользователя; null = не закреплён
  pinnedAt       DateTime?
  /// Порядок среди закреплённых (меньше = выше). null если не закреплён
  pinSortOrder   Int?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@index([userId, pinnedAt, pinSortOrder])
  @@map("conversation_reads")
}

enum MessageKind {
  USER
  FAVORITE_RECEIVED
  FAVORITE_REMOVED
  USER_BLOCKED
  USER_UNBLOCKED
  GAME_DELETED
  DICE_ROLL
  MISSED_VOICE_CALL
}

model Message {
  id                     String       @id @default(cuid())
  conversationId         String
  senderId               String
  body                   String?
  attachmentName         String?
  kind                   MessageKind  @default(USER)
  replyToId              String?
  replyToBody            String?
  replyToSenderNickname  String?
  replyToHasMedia        Boolean      @default(false)
  forwardedFromUserId    String?
  forwardedFromNickname  String?
  forwardedFromMessageId String?
  createdAt              DateTime     @default(now())
  conversation           Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender                 User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo                Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies                Message[]    @relation("MessageReplies")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@map("messages")
}

enum NotificationType {
  FAVORITE_RECEIVED
  FAVORITE_RETURNED
  GAME_APPLICATION
  GAME_APPLICATION_ACCEPTED
  GAME_APPLICATION_REJECTED
  GAME_PLAYER_REMOVED
  GAME_DELETED
  CLUB_DELETED
  SYSTEM_ANNOUNCEMENT
}

enum BroadcastCampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String
  type      NotificationType
  subject   String           @default("")
  /// Free-form body (system announcements). Empty for typed events.
  body      String           @default("")
  refId     String           @default("")
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actor     User             @relation("NotificationsActed", fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([userId, type, actorId, refId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Admin mass notifications (in-app + optional push).
model BroadcastCampaign {
  id             String                  @id @default(cuid())
  title          String
  body           String
  filters        Json                    @default("{}")
  /// Channels: in_app (always), push (optional)
  sendInApp      Boolean                 @default(true)
  sendPush       Boolean                 @default(true)
  status         BroadcastCampaignStatus @default(DRAFT)
  createdById    String?
  recipientCount Int                     @default(0)
  sentCount      Int                     @default(0)
  pushCount      Int                     @default(0)
  error          String?
  createdAt      DateTime                @default(now())
  sentAt         DateTime?
  updatedAt      DateTime                @updatedAt

  @@index([createdAt])
  @@map("broadcast_campaigns")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

enum AnalyticsPlatform {
  WEB
  ANDROID
  IOS
  SERVER
}

model AnalyticsEvent {
  id         String            @id @default(cuid())
  name       String
  userId     String?
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform   AnalyticsPlatform @default(SERVER)
  appVersion String?
  occurredAt DateTime          @default(now())
  props      Json              @default("{}")
  createdAt  DateTime          @default(now())

  @@index([name, occurredAt])
  @@index([userId, occurredAt])
  @@index([occurredAt])
  @@map("analytics_events")
}

model AnalyticsDailyMetric {
  id        String   @id @default(cuid())
  day       DateTime @db.Date
  metric    String
  value     Float
  updatedAt DateTime @updatedAt

  @@unique([day, metric])
  @@index([day])
  @@map("analytics_daily_metrics")
}

/**
 * Key-value app config (e.g. Yandex Metrika counter).
 */
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model AuthorProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String       @default("")
  categories  String[]     @default([])
  contacts    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  posts       AuthorPost[]

  @@map("author_profiles")
}

model AuthorPost {
  id                  String           @id @default(cuid())
  authorProfileId     String
  authorProfile       AuthorProfile    @relation(fields: [authorProfileId], references: [id], onDelete: Cascade)
  title               String
  content             String           @default("")
  category            String
  views               Int              @default(0)
  likesCount          Int              @default(0)
  isForSale           Boolean          @default(false)
  price               Float?
  currency            String?
  purchaseDescription String?
  purchaseUrl         String?
  /// [{ id, name, size, type, index }] — метаданные файлов (не картинок)
  filesMeta           Json?
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  likes               AuthorPostLike[]

  @@index([authorProfileId, deletedAt, createdAt])
  @@index([category, deletedAt, createdAt])
  @@index([deletedAt, createdAt])
  @@map("author_posts")
}

model AuthorPostLike {
  postId    String
  userId    String
  createdAt DateTime   @default(now())
  post      AuthorPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("author_post_likes")
}

enum MarketingLandingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/**
 * Editable landing and its immutable published snapshots.
 */
model MarketingLanding {
  id                 String                      @id @default(cuid())
  name               String
  slug               String                      @unique
  description        String?
  status             MarketingLandingStatus      @default(DRAFT)
  draftContent       Json                        @default("{}")
  draftSeo           Json                        @default("{}")
  publishedVersionId String?                     @unique
  publishedVersion   MarketingLandingVersion?    @relation("MarketingLandingPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions           MarketingLandingVersion[]   @relation("MarketingLandingVersions")
  campaignVariants   MarketingCampaignVariant[]
  attributionTouches MarketingAttributionTouch[]
  conversions        MarketingConversion[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  publishedAt        DateTime?

  @@index([status, publishedAt])
  @@map("marketing_landings")
}

/**
 * A frozen content/SEO snapshot created only by publishing a landing.
 */
model MarketingLandingVersion {
  id           String            @id @default(cuid())
  landingId    String
  landing      MarketingLanding  @relation("MarketingLandingVersions", fields: [landingId], references: [id], onDelete: Cascade)
  version      Int
  content      Json
  seo          Json              @default("{}")
  createdAt    DateTime          @default(now())
  publishedAt  DateTime?
  publishedFor MarketingLanding? @relation("MarketingLandingPublishedVersion")

  @@unique([landingId, version])
  @@index([landingId, publishedAt])
  @@map("marketing_landing_versions")
}

enum MarketingCampaignPlatform {
  YANDEX_DIRECT
  TELEGRAM
  TIKTOK
  OTHER
}

enum MarketingCampaignStatus {
  DRAFT
  READY
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum MarketingExpenseSource {
  MANUAL
  YANDEX_DIRECT_API
}

model MarketingCampaign {
  id                 String                      @id @default(cuid())
  name               String
  description        String?
  platform           MarketingCampaignPlatform   @default(OTHER)
  status             MarketingCampaignStatus     @default(DRAFT)
  objective          String?
  plannedBudget      Decimal?                    @db.Decimal(14, 2)
  currency           String                      @default("RUB") @db.VarChar(3)
  externalCampaignId String?
  startsAt           DateTime?
  endsAt             DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  variants           MarketingCampaignVariant[]
  expenses           MarketingExpense[]
  attributionTouches MarketingAttributionTouch[]
  conversions        MarketingConversion[]

  @@index([status, startsAt])
  @@map("marketing_campaigns")
}

model MarketingCampaignVariant {
  id                 String                      @id @default(cuid())
  campaignId         String
  landingId          String
  name               String
  utmSource          String
  utmMedium          String
  utmCampaign        String
  utmContent         String?
  utmTerm            String?
  utmId              String?
  isActive           Boolean                     @default(true)
  campaign           MarketingCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  landing            MarketingLanding            @relation(fields: [landingId], references: [id], onDelete: Restrict)
  attributionTouches MarketingAttributionTouch[]
  conversions        MarketingConversion[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([campaignId, isActive])
  @@index([landingId])
  @@map("marketing_campaign_variants")
}

model MarketingExpense {
  id               String                 @id @default(cuid())
  campaignId       String
  externalRecordId String?
  amount           Decimal                @db.Decimal(14, 2)
  currency         String                 @default("RUB") @db.VarChar(3)
  source           MarketingExpenseSource @default(MANUAL)
  comment          String?
  occurredAt       DateTime
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  campaign         MarketingCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, externalRecordId])
  @@index([campaignId, occurredAt])
  @@map("marketing_expenses")
}

/**
 * An immutable marketing touch. It is intentionally separate from analytics
 * events so attribution can remain queryable after analytics retention or
 * campaign configuration changes.
 */
model MarketingAttributionTouch {
  id          String   @id @default(cuid())
  anonymousId String   @db.Uuid
  userId      String?
  campaignId  String?
  variantId   String?
  landingId   String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  utmId       String?
  yclid       String?
  referrer    String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user        User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign    MarketingCampaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  variant     MarketingCampaignVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  landing     MarketingLanding?         @relation(fields: [landingId], references: [id], onDelete: SetNull)
  conversions MarketingConversion[]

  @@index([anonymousId, occurredAt])
  @@index([userId, occurredAt])
  @@index([campaignId, occurredAt])
  @@index([variantId, occurredAt])
  @@map("marketing_attribution_touches")
}

enum MarketingConversionType {
  LANDING_VIEW
  CTA_CLICK
  REGISTRATION_STARTED
  REGISTRATION_COMPLETED
  PROFILE_CREATED
  GAME_PUBLISHED
  APPLICATION_SENT
  APPLICATION_APPROVED
  MATCH_COMPLETED
}

model MarketingConversion {
  id               String                  @id @default(cuid())
  type             MarketingConversionType
  anonymousId      String?                 @db.Uuid
  userId           String?
  campaignId       String?
  variantId        String?
  landingId        String?
  touchId          String?
  attributionModel String
  idempotencyKey   String                  @unique
  occurredAt       DateTime                @default(now())
  createdAt        DateTime                @default(now())
  props            Json                    @default("{}")

  user     User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign MarketingCampaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  variant  MarketingCampaignVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  landing  MarketingLanding?         @relation(fields: [landingId], references: [id], onDelete: SetNull)
  touch    MarketingAttributionTouch? @relation(fields: [touchId], references: [id], onDelete: SetNull)

  @@index([campaignId, type, occurredAt])
  @@index([userId, type, occurredAt])
  @@index([anonymousId, type, occurredAt])
  @@map("marketing_conversions")
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  href      String
  /// Короткий текст на плашке, если нет logoUrl
  mark      String   @default("")
  accent    String   @default("#157AFE")
  logoUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("partners")
}
