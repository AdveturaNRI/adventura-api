PORT=3000
DATABASE_URL="postgresql://adventura:adventura@localhost:5444/adventura?schema=public"
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="30"
ADMIN_EMAIL="admin@adventura.local"
ADMIN_PASSWORD="admin123"
ADMIN_COOKIE_SECRET="change-admin-cookie-secret-in-production"
ADMIN_SESSION_SECRET="change-admin-session-secret-in-production"
PUBLIC_URL="http://localhost:3000"
MAX_UPLOAD_MB=10
# Yandex Object Storage (S3-compatible)
S3_ENDPOINT="https://storage.yandexcloud.net"
# Optional browser-facing S3 endpoint. Required only when S3_ENDPOINT is
# internal to Docker, e.g. S3_ENDPOINT=http://minio:9000 locally.
S3_PUBLIC_ENDPOINT=""
S3_REGION="ru-central1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Presigned URL TTL (seconds). Bucket stays private.
S3_SIGNED_URL_EXPIRES_SEC="3600"
# Set to true for local MinIO; leave false for Yandex Object Storage.
S3_FORCE_PATH_STYLE="false"
DADATA_API_KEY=""
DADATA_SECRET_KEY=""
# Web Push (VAPID). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@adventura.local"
# FusionBrain / Kandinsky (арт-студия). Ключи только на сервере.
FUSIONBRAIN_API_KEY=""
FUSIONBRAIN_SECRET_KEY=""
# Legacy (не используется арт-студией)
HF_TOKEN=""
HF_IMAGE_MODEL="black-forest-labs/FLUX.1-dev"
